    font-size:27px;
}

    p a{
       color:white;
    text-decoration:none;
    }
p a{
  :hover{
    color:blue;
}
}
    
span{
    color:#d32f2f;
}

/* Animations */

@keyframes skate{

    from{
        transform:translateX(-120px);
        opacity:0;
    }

    to{
        transform:translateX(0);
        opacity:1;
    }

}

@keyframes rise{

    from{
        transform:translateY(80px);
        opacity:0;
    }

    to{
        transform:translateY(0);
        opacity:1;
    }
