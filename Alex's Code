     font-weight:600;
      font-family:"Cormorant Garamond", serif;
}

nav a:hover{
    color:red;
}

/* Main Section */

main{
    height:80vh;

    display:flex;
    flex-direction:column;
    justify-content:center;
    text-align:center;
      align-items:center;
    animation:rise 1.5s ease;
}

h1{
    width:1050px;
    font-size:57px;
    font-weight:400;
    line-height:1.3;
    margin-bottom:90px;
}

